# Copy this file to .env and fill in real values locally (for `vercel dev`).
# In production, set the same variables in Vercel → Project → Settings →
# Environment Variables. Never commit the real .env file.

# Token from @BotFather after creating your bot.
TELEGRAM_BOT_TOKEN=

# The chat/user id that should receive form submissions.
# Easiest way to get yours: message your bot once, then open
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
# and read the "chat":{"id": ...} value from the response.
TELEGRAM_CHAT_ID=
